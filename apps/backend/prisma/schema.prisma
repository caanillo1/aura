generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Company {
  id                String             @id @default(uuid()) @db.UniqueIdentifier
  name              String             @db.NVarChar(200)
  commercialName    String?            @db.NVarChar(200)
  nit               String             @unique @db.NVarChar(20)
  logo              String?            @db.NVarChar(500)
  logoData          String?            @db.NVarChar(Max)
  primaryColor      String             @default("#1E3A5F") @db.NVarChar(7)
  secondaryColor    String             @default("#2D5086") @db.NVarChar(7)
  address           String?            @db.NVarChar(300)
  city              String?            @db.NVarChar(100)
  department        String?            @db.NVarChar(100)
  email             String             @unique @db.NVarChar(200)
  phone             String?            @db.NVarChar(50)
  website           String?            @db.NVarChar(200)
  rootPassword      String             @db.NVarChar(200)
  agentRegPassword  String             @db.NVarChar(200)
  smtpHost          String?            @default("smtp.office365.com") @db.NVarChar(200)
  smtpPort          Int                @default(587)
  smtpUser          String?            @db.NVarChar(200)
  smtpPassword      String?            @db.NVarChar(500)
  smtpFromName      String?            @db.NVarChar(200)
  smtpFromEmail     String?            @db.NVarChar(200)
  emailSignature    String?            @db.NVarChar(Max)
  filesBasePath     String             @default("C:\\AURA_FILES\\FILES") @db.NVarChar(500)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivos          Archivo[]
  clients           Client[]
  systemConfigs     SystemConfig[]
  cotizaciones      Cotizacion[]
  cronogramaBloques CronogramaBloque[]
  templateFlows     TemplateFlow[]
  templateModules   TemplateModule[]
  municipios        Municipio[]
  serviceOrders     ServiceOrder[]
  emailTemplates    EmailTemplate[]
  auditLogs         AuditLog[]
  requerimientos    Requerimiento[]
  templateRisks     TemplateRisk[]
  roles             Role[]
  tiposDocumento    TipoDocumento[]
  users             User[]
  faqTipos          FaqTipo[]
  faqs              Faq[]

  @@map("Empresas")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  configKey   String   @db.NVarChar(100)
  configValue String?  @db.NVarChar(Max)
  description String?  @db.NVarChar(500)
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, configKey])
  @@map("ConfiguracionSistema")
}

model Role {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  name        String   @db.NVarChar(100)
  slug        String   @db.NVarChar(50)
  description String?  @db.NVarChar(300)
  permissions String?  @db.NVarChar(Max)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  users       User[]

  @@unique([companyId, slug])
  @@map("RolesSistema")
}

model User {
  id                     String                    @id @default(uuid()) @db.UniqueIdentifier
  companyId              String                    @db.UniqueIdentifier
  roleId                 String                    @db.UniqueIdentifier
  userType               String                    @db.NVarChar(10)
  document               String                    @db.NVarChar(30)
  firstName              String                    @db.NVarChar(100)
  lastName               String                    @db.NVarChar(100)
  email                  String                    @unique @db.NVarChar(200)
  passwordHash           String                    @db.NVarChar(300)
  jobTitle               String?                   @db.NVarChar(150)
  phone                  String?                   @db.NVarChar(30)
  signatureFilePath      String?                   @db.NVarChar(500)
  signatureData          String?                   @db.NVarChar(Max)
  clientId               String?                   @db.UniqueIdentifier
  isActive               Boolean                   @default(true)
  isEmailVerified        Boolean                   @default(false)
  lastLoginAt            DateTime?
  failedLoginCount       Int                       @default(0)
  lockedUntil            DateTime?
  refreshTokenHash       String?                   @db.NVarChar(300)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  actaCompromisosAgent   ActaCompromiso[]          @relation("ActaCompromisoAgent")
  actasCreated           Acta[]                    @relation("ActaCreatedBy")
  actaActividadesAgent   ActaActividad[]           @relation("ActaActividadAgent")
  activitiesAssigned     Activity[]                @relation("ActivityAssignedTo")
  archivosSubidos        Archivo[]                 @relation("ArchivoSubidoPor")
  trainingsTrainer       Training[]                @relation("TrainingTrainer")
  clientsCreated         Client[]                  @relation("ClientCreatedBy")
  cotizacionesCreadas    Cotizacion[]              @relation("CotizacionCreatedBy")
  cronogramaBloques      CronogramaBloque[]        @relation("BloqueAgente")
  bloquesCreadosPor      CronogramaBloque[]        @relation("BloqueCreatedBy")
  documentsGenerated     Document[]                @relation("DocumentGeneratedBy")
  handoversCreated       SupportHandover[]         @relation("HandoverCreatedBy")
  evidenceUploaded       Evidence[]                @relation("EvidenceUploadedBy")
  signaturesUser         Signature[]               @relation("SignatureUser")
  activityThreads        ActivityThread[]          @relation("ThreadAuthor")
  soImplementers         ServiceOrderImplementer[]
  reportsCreated         ScheduledReport[]         @relation("ReportCreatedBy")
  lessonsCreated         LessonsLearned[]          @relation("LessonsCreatedBy")
  notifications          Notification[]
  noveltiesReported      Novelty[]                 @relation("NoveltyReportedBy")
  serviceOrdersClinical  ServiceOrder[]            @relation("SOClinicalLeader")
  serviceOrdersCreated   ServiceOrder[]            @relation("SOCreatedBy")
  serviceOrdersFinancial ServiceOrder[]            @relation("SOFinancialLeader")
  trainingParticipant    TrainingParticipant[]     @relation("ParticipantUser")
  auditLogs              AuditLog[]                @relation("AuditLogUser")
  gestionesReq           RequerimientoGestion[]    @relation("GestionChangedBy")
  requerimientosAgente   Requerimiento[]           @relation("ReqAgente")
  requerimientosCreados  Requerimiento[]           @relation("ReqCreatedBy")
  subActivitiesAssigned  SubActivity[]             @relation("SubActivityAssignedTo")
  client                 Client?                   @relation("UserClient", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company                Company                   @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  role                   Role                      @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  visitsCreated          Visit[]                   @relation("VisitCreatedBy")
  faqsCreados            Faq[]                     @relation("FaqAutor")

  @@map("Usuarios")
}

model Municipio {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  companyId          String   @db.UniqueIdentifier
  codigoDepartamento String   @db.NVarChar(10)
  nombreDepartamento String   @db.NVarChar(100)
  codigoMunicipio    String   @db.NVarChar(10)
  nombreMunicipio    String   @db.NVarChar(100)
  codigoPostal       String?  @db.NVarChar(10)
  actas              Acta[]
  clients            Client[]
  company            Company  @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@unique([companyId, codigoDepartamento, codigoMunicipio])
  @@map("Municipios")
}

model Client {
  id                String             @id @default(uuid()) @db.UniqueIdentifier
  companyId         String             @db.UniqueIdentifier
  nit               String             @db.NVarChar(20)
  businessName      String             @db.NVarChar(200)
  commercialName    String?            @db.NVarChar(200)
  address           String?            @db.NVarChar(300)
  city              String?            @db.NVarChar(100)
  department        String?            @db.NVarChar(100)
  municipioId       String?            @db.UniqueIdentifier
  email             String?            @db.NVarChar(200)
  phone             String?            @db.NVarChar(50)
  economicActivity  String?            @db.NVarChar(200)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?            @db.UniqueIdentifier
  archivos          Archivo[]
  company           Company            @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  createdBy         User?              @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  municipio         Municipio?         @relation(fields: [municipioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cotizaciones      Cotizacion[]
  cronogramaBloques CronogramaBloque[]
  serviceOrders     ServiceOrder[]
  staff             ClientStaff[]
  requerimientos    Requerimiento[]
  users             User[]             @relation("UserClient")

  @@unique([companyId, nit])
  @@map("Clientes")
}

model ClientStaff {
  id                    String                @id @default(uuid()) @db.UniqueIdentifier
  clientId              String                @db.UniqueIdentifier
  document              String                @db.NVarChar(30)
  firstName             String                @db.NVarChar(100)
  lastName              String                @db.NVarChar(100)
  jobTitle              String?               @db.NVarChar(150)
  email                 String?               @db.NVarChar(200)
  phone                 String?               @db.NVarChar(30)
  area                  String?               @db.NVarChar(100)
  isProjectLeader       Boolean               @default(false)
  isTrainingParticipant Boolean               @default(false)
  isActSigner           Boolean               @default(false)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  actaCompromisosClient ActaCompromiso[]      @relation("ActaCompromisoClient")
  actaActividadesClient ActaActividad[]       @relation("ActaActividadClient")
  activitiesAssigned    Activity[]            @relation("ActivityClientStaff")
  signatures            Signature[]           @relation("SignatureStaff")
  serviceOrdersLed      ServiceOrder[]        @relation("SOClientLeader")
  trainingParticipants  TrainingParticipant[] @relation("ParticipantStaff")
  client                Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("PersonalCliente")
}

model TemplateFlow {
  id          String           @id @default(uuid()) @db.UniqueIdentifier
  companyId   String           @db.UniqueIdentifier
  name        String           @db.NVarChar(200)
  description String?          @db.NVarChar(500)
  category    String?          @db.NVarChar(100)
  version     String           @default("1.0") @db.NVarChar(20)
  isActive    Boolean          @default(true)
  isDefault   Boolean          @default(false)
  createdById String?          @db.UniqueIdentifier
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  modules     TemplateModule[]
  projects    Project[]

  @@map("FlujoPlantillas")
}

model TemplateModule {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  companyId      String          @db.UniqueIdentifier
  templateFlowId String?         @db.UniqueIdentifier
  code           String          @db.NVarChar(20)
  name           String          @db.NVarChar(200)
  description    String?         @db.NVarChar(500)
  order          Int             @default(0)
  estimatedDays  Int             @default(0)
  days           Int             @default(0)
  startDate      DateTime?       @db.Date
  endDate        DateTime?       @db.Date
  executionDate  DateTime?       @db.Date
  isActive       Boolean         @default(true)
  phases         TemplatePhase[]
  company        Company         @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  templateFlow   TemplateFlow?   @relation(fields: [templateFlowId], references: [id], onDelete: Cascade)
  requerimientos Requerimiento[] @relation("ReqModule")

  @@unique([companyId, code])
  @@map("ModulosPlantilla")
}

model TemplatePhase {
  id               String             @id @default(uuid()) @db.UniqueIdentifier
  templateModuleId String             @db.UniqueIdentifier
  name             String             @db.NVarChar(200)
  slug             String             @db.NVarChar(50)
  order            Int                @default(0)
  estimatedDays    Int                @default(0)
  startDate        DateTime?          @db.Date
  endDate          DateTime?          @db.Date
  executionDate    DateTime?          @db.Date
  color            String?            @db.NVarChar(7)
  icon             String?            @db.NVarChar(100)
  activities       TemplateActivity[]
  templateModule   TemplateModule     @relation(fields: [templateModuleId], references: [id], onDelete: Cascade)
  requerimientos   Requerimiento[]    @relation("ReqPhase")

  @@map("FasesPlantilla")
}

model TemplateActivity {
  id              String                @id @default(uuid()) @db.UniqueIdentifier
  templatePhaseId String                @db.UniqueIdentifier
  code            String                @db.NVarChar(20)
  name            String                @db.NVarChar(300)
  description     String?               @db.NVarChar(Max)
  order           Int                   @default(0)
  estimatedHours  Decimal               @default(0) @db.Decimal(6, 2)
  calculatedDays  Int                   @default(0)
  defaultRole     String?               @db.NVarChar(50)
  priority        String                @default("media") @db.NVarChar(20)
  assigneeType    String?               @db.NVarChar(20)
  assigneeId      String?               @db.UniqueIdentifier
  startDate       DateTime?             @db.Date
  endDate         DateTime?             @db.Date
  executionDate   DateTime?             @db.Date
  templatePhase   TemplatePhase         @relation(fields: [templatePhaseId], references: [id], onDelete: Cascade)
  subActivities   TemplateSubActivity[]

  @@map("ActividadesPlantilla")
}

model TemplateSubActivity {
  id                 String           @id @default(uuid()) @db.UniqueIdentifier
  templateActivityId String           @db.UniqueIdentifier
  name               String           @db.NVarChar(300)
  description        String?          @db.NVarChar(Max)
  order              Int              @default(0)
  estimatedHours     Decimal          @default(0) @db.Decimal(6, 2)
  templateActivity   TemplateActivity @relation(fields: [templateActivityId], references: [id], onDelete: Cascade)

  @@map("SubActividadesPlantilla")
}

model TemplateRisk {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  name        String   @db.NVarChar(300)
  description String?  @db.NVarChar(Max)
  category    String?  @db.NVarChar(100)
  level       String   @default("media") @db.NVarChar(20)
  mitigation  String?  @db.NVarChar(Max)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@map("RiesgosPlantilla")
}

model ServiceOrder {
  id                String                    @id @default(uuid()) @db.UniqueIdentifier
  companyId         String                    @db.UniqueIdentifier
  clientId          String                    @db.UniqueIdentifier
  osNumber          String                    @db.NVarChar(50)
  ticketRubi        String?                   @db.NVarChar(100)
  product           String                    @db.NVarChar(200)
  scope             String?                   @db.NVarChar(Max)
  durationDays      Int                       @default(0)
  startDate         DateTime                  @db.Date
  endDate           DateTime                  @db.Date
  observations      String?                   @db.NVarChar(Max)
  clinicalLeaderId  String?                   @db.UniqueIdentifier
  financialLeaderId String?                   @db.UniqueIdentifier
  clientLeaderId    String?                   @db.UniqueIdentifier
  status            String                    @default("pendiente") @db.NVarChar(30)
  createdById       String                    @db.UniqueIdentifier
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivos          Archivo[]
  cronogramaBloques CronogramaBloque[]
  history           ServiceOrderHistory[]
  implementers      ServiceOrderImplementer[]
  client            Client                    @relation(fields: [clientId], references: [id], onUpdate: NoAction)
  clientLeader      ClientStaff?              @relation("SOClientLeader", fields: [clientLeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinicalLeader    User?                     @relation("SOClinicalLeader", fields: [clinicalLeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company           Company                   @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  createdBy         User                      @relation("SOCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  financialLeader   User?                     @relation("SOFinancialLeader", fields: [financialLeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project           Project?
  requerimientos    Requerimiento[]

  @@unique([companyId, osNumber])
  @@map("OrdenesServicio")
}

model ServiceOrderImplementer {
  serviceOrderId String       @db.UniqueIdentifier
  userId         String       @db.UniqueIdentifier
  role           String       @default("apoyo") @db.NVarChar(50)
  assignedAt     DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@id([serviceOrderId, userId])
  @@map("ImplementadoresOS")
}

model ServiceOrderHistory {
  id             String       @id @default(uuid()) @db.UniqueIdentifier
  serviceOrderId String       @db.UniqueIdentifier
  changedById    String       @db.UniqueIdentifier
  fieldName      String       @db.NVarChar(100)
  oldValue       String?      @db.NVarChar(Max)
  newValue       String?      @db.NVarChar(Max)
  reason         String?      @db.NVarChar(500)
  noteType       String?      @db.NVarChar(20)
  noteLevel      String?      @db.NVarChar(20)
  noteSubtype    String?      @db.NVarChar(30)
  noteMitigation String?      @db.NVarChar(Max)
  createdAt      DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("HistorialOS")
}

model Project {
  id               String            @id @default(uuid()) @db.UniqueIdentifier
  serviceOrderId   String            @unique @db.UniqueIdentifier
  templateFlowId   String?           @db.UniqueIdentifier
  name             String            @db.NVarChar(300)
  description      String?           @db.NVarChar(Max)
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  progressPercent  Decimal           @default(0) @db.Decimal(5, 2)
  status           String            @default("activo") @db.NVarChar(30)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  actas            Acta[]
  trainings        Training[]
  documents        Document[]
  supportHandover  SupportHandover?
  scheduledReports ScheduledReport[]
  lessonsLearned   LessonsLearned[]
  modules          ProjectModule[]
  novelties        Novelty[]
  serviceOrder     ServiceOrder      @relation(fields: [serviceOrderId], references: [id], onUpdate: NoAction)
  templateFlow     TemplateFlow?     @relation(fields: [templateFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  risks            Risk[]
  visits           Visit[]

  @@map("Proyectos")
}

model ProjectModule {
  id              String           @id @default(uuid()) @db.UniqueIdentifier
  projectId       String           @db.UniqueIdentifier
  name            String           @db.NVarChar(200)
  order           Int              @default(0)
  progressPercent Decimal          @default(0) @db.Decimal(5, 2)
  isActive        Boolean          @default(true)
  startDate       DateTime?        @db.DateTime
  endDate         DateTime?        @db.DateTime
  actaCompromisos ActaCompromiso[] @relation("ActaCompromisoModule")
  actas           Acta[]           @relation("ActaModulo")
  trainings       Training[]       @relation("TrainingModule")
  phases          Phase[]
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ModulosProyecto")
}

model Phase {
  id              String           @id @default(uuid()) @db.UniqueIdentifier
  projectModuleId String           @db.UniqueIdentifier
  name            String           @db.NVarChar(200)
  slug            String?          @db.NVarChar(50)
  order           Int              @default(0)
  startDate       DateTime?        @db.Date
  endDate         DateTime?        @db.Date
  executionDate   DateTime?        @db.Date
  progressPercent Decimal          @default(0) @db.Decimal(5, 2)
  status          String           @default("pendiente") @db.NVarChar(30)
  color           String?          @db.NVarChar(7)
  icon            String?          @db.NVarChar(100)
  responsibleId   String?          @db.UniqueIdentifier
  clientStaffId   String?          @db.UniqueIdentifier
  actaCompromisos ActaCompromiso[] @relation("ActaCompromisoPhase")
  activities      Activity[]
  projectModule   ProjectModule    @relation(fields: [projectModuleId], references: [id], onDelete: Cascade)

  @@map("Fases")
}

model Activity {
  id               String               @id @default(uuid()) @db.UniqueIdentifier
  phaseId          String               @db.UniqueIdentifier
  code             String               @db.NVarChar(30)
  name             String               @db.NVarChar(300)
  description      String?              @db.NVarChar(Max)
  assignedToId     String?              @db.UniqueIdentifier
  assigneeType     String?              @db.NVarChar(20)
  clientStaffId    String?              @db.UniqueIdentifier
  priority         String               @default("media") @db.NVarChar(20)
  status           String               @default("pendiente") @db.NVarChar(30)
  plannedStartDate DateTime?            @db.Date
  plannedEndDate   DateTime?            @db.Date
  actualStartDate  DateTime?            @db.Date
  actualEndDate    DateTime?            @db.Date
  executionDate    DateTime?            @db.Date
  calculatedDays   Int                  @default(0)
  plannedHours     Decimal              @default(0) @db.Decimal(6, 2)
  actualHours      Decimal              @default(0) @db.Decimal(6, 2)
  progressPercent  Decimal              @default(0) @db.Decimal(5, 2)
  observations     String?              @db.NVarChar(Max)
  order            Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  blockedBy        String?              @db.NVarChar(20)
  blockedNote      String?              @db.NVarChar(Max)
  blockedSince     DateTime?
  clientDelayDays  Int                  @default(0)
  actaActividades  ActaActividad[]      @relation("ActaActividadActivity")
  assignedTo       User?                @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientStaff      ClientStaff?         @relation("ActivityClientStaff", fields: [clientStaffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  phase            Phase                @relation(fields: [phaseId], references: [id], onUpdate: NoAction)
  visitActivities  VisitActivity[]
  blockLogs        ActivityBlockLog[]
  dependencies     ActivityDependency[] @relation("ADActivity")
  dependsOn        ActivityDependency[] @relation("ADDependsOn")
  threads          ActivityThread[]
  subActivities    SubActivity[]

  @@map("Actividades")
}

model ActivityBlockLog {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  activityId    String   @db.UniqueIdentifier
  blockedBy     String   @db.NVarChar(20)
  blockedNote   String   @db.NVarChar(Max)
  blockedSince  DateTime
  unlockedAt    DateTime
  diasBloqueado Int      @default(0)
  unlockNote    String?  @db.NVarChar(Max)
  createdAt     DateTime @default(now())
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("ActivityBlockLogs")
}

model ActivityThread {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  activityId String   @db.UniqueIdentifier
  authorId   String   @db.UniqueIdentifier
  authorType String   @default("agent") @db.NVarChar(20)
  content    String   @db.NVarChar(Max)
  newStatus  String?  @db.NVarChar(30)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author     User     @relation("ThreadAuthor", fields: [authorId], references: [id], onUpdate: NoAction)

  @@map("HilosActividad")
}

model ActivityDependency {
  activityId          String   @db.UniqueIdentifier
  dependsOnActivityId String   @db.UniqueIdentifier
  activity            Activity @relation("ADActivity", fields: [activityId], references: [id], onDelete: Cascade)
  dependsOn           Activity @relation("ADDependsOn", fields: [dependsOnActivityId], references: [id], onUpdate: NoAction)

  @@id([activityId, dependsOnActivityId])
  @@map("DependenciasActividad")
}

model SubActivity {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  activityId       String    @db.UniqueIdentifier
  name             String    @db.NVarChar(300)
  description      String?   @db.NVarChar(Max)
  assignedToId     String?   @db.UniqueIdentifier
  progressPercent  Decimal   @default(0) @db.Decimal(5, 2)
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  actualStartDate  DateTime? @db.Date
  actualEndDate    DateTime? @db.Date
  status           String    @default("pendiente") @db.NVarChar(30)
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  activity         Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignedTo       User?     @relation("SubActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("SubActividades")
}

model Visit {
  id              String          @id @default(uuid()) @db.UniqueIdentifier
  projectId       String          @db.UniqueIdentifier
  visitType       String          @default("con_acta") @db.NVarChar(20)
  visitDate       DateTime        @db.Date
  startTime       DateTime?       @db.Time
  endTime         DateTime?       @db.Time
  location        String?         @db.NVarChar(200)
  objective       String?         @db.NVarChar(Max)

  id          String           @id @default(uuid()) @db.UniqueIdentifier
  companyId   String           @db.UniqueIdentifier
  numero      String           @db.NVarChar(20)
  titulo      String           @db.NVarChar(300)
  clientId    String?          @db.UniqueIdentifier
  prospecto   String?          @db.NVarChar(200)
  contacto    String?          @db.NVarChar(200)
  email       String?          @db.NVarChar(200)
  telefono    String?          @db.NVarChar(50)
  valor       Decimal?         @db.Decimal(18, 2)
  status      String           @default("borrador") @db.NVarChar(30)
  descripcion String?          @db.NVarChar(Max)
  validHasta  DateTime?        @db.Date
  notas       String?          @db.NVarChar(Max)
  createdById String           @db.UniqueIdentifier
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company     Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  createdBy   User             @relation("CotizacionCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  items       CotizacionItem[]

  @@unique([companyId, numero])
  @@map("Cotizaciones")
}

model CotizacionItem {
  id            String     @id @default(uuid()) @db.UniqueIdentifier
  cotizacionId  String     @db.UniqueIdentifier
  descripcion   String     @db.NVarChar(300)
  cantidad      Decimal    @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal    @db.Decimal(18, 2)
  descuento     Decimal    @default(0) @db.Decimal(5, 2)
  cotizacion    Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("CotizacionItems")
}

// ── FAQ ──────────────────────────────────────────────────────────────────────

model FaqTipo {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  nombre      String   @db.NVarChar(100)
  color       String?  @db.NVarChar(7)
  icono       String?  @db.NVarChar(50)
  descripcion String?  @db.NVarChar(300)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  faqs    Faq[]

  @@unique([companyId, nombre])
  @@map("FaqTipos")
}

model Faq {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  tipoId      String?  @db.UniqueIdentifier
  titulo      String   @db.NVarChar(300)
  descripcion String?  @db.NVarChar(500)
  contenido   String   @db.NVarChar(Max)
  etiquetas   String?  @db.NVarChar(Max)
  autorId     String?  @db.UniqueIdentifier
  activo      Boolean  @default(true)
  vistas      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tipo    FaqTipo? @relation(fields: [tipoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  autor   User?    @relation("FaqAutor", fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Faqs")
}

// =============================================================================
// AURA ERP – Prisma Schema
// SQL Server 2016 · Prisma 5.x
// Tablas mapeadas con @@map para evitar palabras reservadas de SQL Server
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// =============================================================================
// SECCIÓN 1: EMPRESA / CONFIGURACIÓN
// =============================================================================

model Company {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  name             String   @db.NVarChar(200)
  commercialName   String?  @db.NVarChar(200)
  nit              String   @unique @db.NVarChar(20)
  logo             String?  @db.NVarChar(500)
  primaryColor     String   @default("#1E3A5F") @db.NVarChar(7)
  secondaryColor   String   @default("#2D5086") @db.NVarChar(7)
  address          String?  @db.NVarChar(300)
  city             String?  @db.NVarChar(100)
  department       String?  @db.NVarChar(100)
  email            String   @unique @db.NVarChar(200)
  phone            String?  @db.NVarChar(50)
  website          String?  @db.NVarChar(200)
  rootPassword     String   @db.NVarChar(200)
  agentRegPassword String   @db.NVarChar(200)
  smtpHost         String?  @default("smtp.office365.com") @db.NVarChar(200)
  smtpPort         Int      @default(587)
  smtpUser         String?  @db.NVarChar(200)
  smtpPassword     String?  @db.NVarChar(500)
  smtpFromName     String?  @db.NVarChar(200)
  smtpFromEmail    String?  @db.NVarChar(200)
  emailSignature   String?  @db.NVarChar(Max)
  filesBasePath    String   @default("C:\\AURA_FILES\\FILES") @db.NVarChar(500)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  // Relaciones
  users            User[]
  roles            Role[]
  clients          Client[]
  serviceOrders    ServiceOrder[]
  systemConfigs    SystemConfig[]
  templateFlows    TemplateFlow[]
  templateRisks    TemplateRisk[]
  emailTemplates   EmailTemplate[]
  auditLogs        AuditLog[]

  @@map("Empresas")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  configKey   String   @db.NVarChar(100)
  configValue String?  @db.NVarChar(Max)
  description String?  @db.NVarChar(500)
  updatedAt   DateTime @updatedAt @db.DateTime2

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, configKey])
  @@map("ConfiguracionSistema")
}

// =============================================================================
// SECCIÓN 2: USUARIOS Y AUTENTICACIÓN
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  name        String   @db.NVarChar(100)
  slug        String   @db.NVarChar(50)
  description String?  @db.NVarChar(300)
  permissions String?  @db.NVarChar(Max)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime2

  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       User[]

  @@unique([companyId, slug])
  @@map("RolesSistema")
}

model User {
  id                String    @id @default(uuid()) @db.UniqueIdentifier
  companyId         String    @db.UniqueIdentifier
  roleId            String    @db.UniqueIdentifier
  userType          String    @db.NVarChar(10)   // 'agent' | 'client'
  document          String    @db.NVarChar(30)
  firstName         String    @db.NVarChar(100)
  lastName          String    @db.NVarChar(100)
  email             String    @unique @db.NVarChar(200)
  passwordHash      String    @db.NVarChar(300)
  jobTitle          String?   @db.NVarChar(150)
  phone             String?   @db.NVarChar(30)
  signatureFilePath String?   @db.NVarChar(500)
  clientId          String?   @db.UniqueIdentifier
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  lastLoginAt       DateTime? @db.DateTime2
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.DateTime2
  refreshTokenHash  String?   @db.NVarChar(300)
  createdAt         DateTime  @default(now()) @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  // Relaciones hacia arriba
  company           Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role              Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client            Client?   @relation("UserClient", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relaciones hacia abajo
  notifications        Notification[]
  auditLogs            AuditLog[]               @relation("AuditLogUser")
  activitiesAssigned   Activity[]               @relation("ActivityAssignedTo")
  subActivitiesAssigned SubActivity[]           @relation("SubActivityAssignedTo")
  visitsCreated        Visit[]                  @relation("VisitCreatedBy")
  trainingsTrainer     Training[]               @relation("TrainingTrainer")
  documentsGenerated   Document[]               @relation("DocumentGeneratedBy")
  evidenceUploaded     Evidence[]               @relation("EvidenceUploadedBy")
  signaturesUser       Signature[]              @relation("SignatureUser")
  serviceOrdersCreated ServiceOrder[]           @relation("SOCreatedBy")
  serviceOrdersClinical ServiceOrder[]          @relation("SOClinicalLeader")
  serviceOrdersFinancial ServiceOrder[]         @relation("SOFinancialLeader")
  clientsCreated       Client[]                 @relation("ClientCreatedBy")
  noveltiesReported    Novelty[]                @relation("NoveltyReportedBy")
  lessonsCreated       LessonsLearned[]         @relation("LessonsCreatedBy")
  handoversCreated     SupportHandover[]        @relation("HandoverCreatedBy")
  reportsCreated       ScheduledReport[]        @relation("ReportCreatedBy")
  trainingParticipant  TrainingParticipant[]    @relation("ParticipantUser")
  soImplementers       ServiceOrderImplementer[]

  @@map("Usuarios")
}

// =============================================================================
// SECCIÓN 3: CLIENTES
// =============================================================================

model Client {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  companyId        String   @db.UniqueIdentifier
  nit              String   @db.NVarChar(20)
  businessName     String   @db.NVarChar(200)
  commercialName   String?  @db.NVarChar(200)
  address          String?  @db.NVarChar(300)
  city             String?  @db.NVarChar(100)
  department       String?  @db.NVarChar(100)
  email            String?  @db.NVarChar(200)
  phone            String?  @db.NVarChar(50)
  economicActivity String?  @db.NVarChar(200)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2
  createdById      String?  @db.UniqueIdentifier

  company          Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy        User?    @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            User[]   @relation("UserClient")
  staff            ClientStaff[]
  serviceOrders    ServiceOrder[]

  @@unique([companyId, nit])
  @@map("Clientes")
}

model ClientStaff {
  id                    String   @id @default(uuid()) @db.UniqueIdentifier
  clientId              String   @db.UniqueIdentifier
  document              String   @db.NVarChar(30)
  firstName             String   @db.NVarChar(100)
  lastName              String   @db.NVarChar(100)
  jobTitle              String?  @db.NVarChar(150)
  email                 String?  @db.NVarChar(200)
  phone                 String?  @db.NVarChar(30)
  area                  String?  @db.NVarChar(100)
  isProjectLeader       Boolean  @default(false)
  isTrainingParticipant Boolean  @default(false)
  isActSigner           Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.DateTime2

  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  signatures            Signature[]            @relation("SignatureStaff")
  trainingParticipants  TrainingParticipant[]  @relation("ParticipantStaff")

  @@map("PersonalCliente")
}

// =============================================================================
// SECCIÓN 4: MOTOR DE PLANTILLAS
// =============================================================================

model TemplateFlow {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  name        String   @db.NVarChar(200)
  description String?  @db.NVarChar(500)
  category    String?  @db.NVarChar(100)
  version     String   @default("1.0") @db.NVarChar(20)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdById String?  @db.UniqueIdentifier
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2

  company     Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules     TemplateModule[]
  projects    Project[]

  @@map("FlujoPlantillas")
}

model TemplateModule {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  templateFlowId String   @db.UniqueIdentifier
  name           String   @db.NVarChar(200)
  description    String?  @db.NVarChar(500)
  order          Int      @default(0)
  estimatedDays  Int      @default(0)
  isActive       Boolean  @default(true)

  templateFlow   TemplateFlow    @relation(fields: [templateFlowId], references: [id], onDelete: Cascade)
  phases         TemplatePhase[]

  @@map("ModulosPlantilla")
}

model TemplatePhase {
  id               String   @id @default(uuid()) @db.UniqueIdentifier
  templateModuleId String   @db.UniqueIdentifier
  name             String   @db.NVarChar(200)
  slug             String   @db.NVarChar(50)
  order            Int      @default(0)
  estimatedDays    Int      @default(0)
  color            String?  @db.NVarChar(7)
  icon             String?  @db.NVarChar(100)

  templateModule   TemplateModule     @relation(fields: [templateModuleId], references: [id], onDelete: Cascade)
  activities       TemplateActivity[]

  @@map("FasesPlantilla")
}

model TemplateActivity {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  templatePhaseId String   @db.UniqueIdentifier
  code            String   @db.NVarChar(20)
  name            String   @db.NVarChar(300)
  description     String?  @db.NVarChar(Max)
  order           Int      @default(0)
  estimatedHours  Decimal  @default(0) @db.Decimal(6, 2)
  defaultRole     String?  @db.NVarChar(50)
  priority        String   @default("media") @db.NVarChar(20)

  templatePhase   TemplatePhase          @relation(fields: [templatePhaseId], references: [id], onDelete: Cascade)
  subActivities   TemplateSubActivity[]

  @@map("ActividadesPlantilla")
}

model TemplateSubActivity {
  id                 String   @id @default(uuid()) @db.UniqueIdentifier
  templateActivityId String   @db.UniqueIdentifier
  name               String   @db.NVarChar(300)
  description        String?  @db.NVarChar(Max)
  order              Int      @default(0)
  estimatedHours     Decimal  @default(0) @db.Decimal(6, 2)

  templateActivity   TemplateActivity @relation(fields: [templateActivityId], references: [id], onDelete: Cascade)

  @@map("SubActividadesPlantilla")
}

model TemplateRisk {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  name        String   @db.NVarChar(300)
  description String?  @db.NVarChar(Max)
  category    String?  @db.NVarChar(100)
  level       String   @default("media") @db.NVarChar(20)
  mitigation  String?  @db.NVarChar(Max)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime2

  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("RiesgosPlantilla")
}

// =============================================================================
// SECCIÓN 5: ÓRDENES DE SERVICIO
// =============================================================================

model ServiceOrder {
  id                String   @id @default(uuid()) @db.UniqueIdentifier
  companyId         String   @db.UniqueIdentifier
  clientId          String   @db.UniqueIdentifier
  osNumber          String   @db.NVarChar(50)
  product           String   @db.NVarChar(200)
  scope             String?  @db.NVarChar(Max)
  durationDays      Int      @default(0)
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  observations      String?  @db.NVarChar(Max)
  clinicalLeaderId  String?  @db.UniqueIdentifier
  financialLeaderId String?  @db.UniqueIdentifier
  status            String   @default("pendiente") @db.NVarChar(30)
  createdById       String   @db.UniqueIdentifier
  createdAt         DateTime @default(now()) @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  company           Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client            Client   @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy         User     @relation("SOCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinicalLeader    User?    @relation("SOClinicalLeader", fields: [clinicalLeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  financialLeader   User?    @relation("SOFinancialLeader", fields: [financialLeaderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  implementers      ServiceOrderImplementer[]
  history           ServiceOrderHistory[]
  project           Project?

  @@unique([companyId, osNumber])
  @@map("OrdenesServicio")
}

model ServiceOrderImplementer {
  serviceOrderId String   @db.UniqueIdentifier
  userId         String   @db.UniqueIdentifier
  role           String   @default("apoyo") @db.NVarChar(50)
  assignedAt     DateTime @default(now()) @db.DateTime2

  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([serviceOrderId, userId])
  @@map("ImplementadoresOS")
}

model ServiceOrderHistory {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  serviceOrderId String   @db.UniqueIdentifier
  changedById    String   @db.UniqueIdentifier
  fieldName      String   @db.NVarChar(100)
  oldValue       String?  @db.NVarChar(Max)
  newValue       String?  @db.NVarChar(Max)
  reason         String?  @db.NVarChar(500)
  createdAt      DateTime @default(now()) @db.DateTime2

  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("HistorialOS")
}

// =============================================================================
// SECCIÓN 6: PROYECTOS
// =============================================================================

model Project {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  serviceOrderId  String   @unique @db.UniqueIdentifier
  templateFlowId  String?  @db.UniqueIdentifier
  name            String   @db.NVarChar(300)
  description     String?  @db.NVarChar(Max)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  progressPercent Decimal  @default(0) @db.Decimal(5, 2)
  status          String   @default("activo") @db.NVarChar(30)
  createdAt       DateTime @default(now()) @db.DateTime2
  updatedAt       DateTime @updatedAt @db.DateTime2

  serviceOrder     ServiceOrder   @relation(fields: [serviceOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templateFlow     TemplateFlow?  @relation(fields: [templateFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules          ProjectModule[]
  visits           Visit[]
  trainings        Training[]
  documents        Document[]
  novelties        Novelty[]
  lessonsLearned   LessonsLearned[]
  supportHandover  SupportHandover?
  scheduledReports ScheduledReport[]
  risks            Risk[]

  @@map("Proyectos")
}

model ProjectModule {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  projectId       String   @db.UniqueIdentifier
  name            String   @db.NVarChar(200)
  order           Int      @default(0)
  progressPercent Decimal  @default(0) @db.Decimal(5, 2)
  isActive        Boolean  @default(true)

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phases          Phase[]
  trainings       Training[] @relation("TrainingModule")

  @@map("ModulosProyecto")
}

model Phase {
  id              String    @id @default(uuid()) @db.UniqueIdentifier
  projectModuleId String    @db.UniqueIdentifier
  name            String    @db.NVarChar(200)
  slug            String?   @db.NVarChar(50)
  order           Int       @default(0)
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  progressPercent Decimal   @default(0) @db.Decimal(5, 2)
  status          String    @default("pendiente") @db.NVarChar(30)
  color           String?   @db.NVarChar(7)
  icon            String?   @db.NVarChar(100)

  projectModule   ProjectModule @relation(fields: [projectModuleId], references: [id], onDelete: Cascade)
  activities      Activity[]

  @@map("Fases")
}

model Activity {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  phaseId          String    @db.UniqueIdentifier
  code             String    @db.NVarChar(30)
  name             String    @db.NVarChar(300)
  description      String?   @db.NVarChar(Max)
  assignedToId     String?   @db.UniqueIdentifier
  priority         String    @default("media") @db.NVarChar(20)
  status           String    @default("pendiente") @db.NVarChar(30)
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  actualStartDate  DateTime? @db.Date
  actualEndDate    DateTime? @db.Date
  plannedHours     Decimal   @default(0) @db.Decimal(6, 2)
  actualHours      Decimal   @default(0) @db.Decimal(6, 2)
  progressPercent  Decimal   @default(0) @db.Decimal(5, 2)
  observations     String?   @db.NVarChar(Max)
  order            Int       @default(0)
  createdAt        DateTime  @default(now()) @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  phase            Phase     @relation(fields: [phaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedTo       User?     @relation("ActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subActivities    SubActivity[]
  visitActivities  VisitActivity[]
  dependencies     ActivityDependency[] @relation("ADActivity")
  dependsOn        ActivityDependency[] @relation("ADDependsOn")

  @@map("Actividades")
}

model ActivityDependency {
  activityId          String @db.UniqueIdentifier
  dependsOnActivityId String @db.UniqueIdentifier

  activity  Activity @relation("ADActivity", fields: [activityId], references: [id], onDelete: Cascade)
  dependsOn Activity @relation("ADDependsOn", fields: [dependsOnActivityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([activityId, dependsOnActivityId])
  @@map("DependenciasActividad")
}

model SubActivity {
  id               String    @id @default(uuid()) @db.UniqueIdentifier
  activityId       String    @db.UniqueIdentifier
  name             String    @db.NVarChar(300)
  description      String?   @db.NVarChar(Max)
  assignedToId     String?   @db.UniqueIdentifier
  progressPercent  Decimal   @default(0) @db.Decimal(5, 2)
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date
  actualStartDate  DateTime? @db.Date
  actualEndDate    DateTime? @db.Date
  status           String    @default("pendiente") @db.NVarChar(30)
  order            Int       @default(0)
  createdAt        DateTime  @default(now()) @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  activity     Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  assignedTo   User?     @relation("SubActivityAssignedTo", fields: [assignedToId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("SubActividades")
}

// =============================================================================
// SECCIÓN 7: VISITAS
// =============================================================================

model Visit {
  id             String    @id @default(uuid()) @db.UniqueIdentifier
  projectId      String    @db.UniqueIdentifier
  visitType      String    @default("con_acta") @db.NVarChar(20)
  visitDate      DateTime  @db.Date
  startTime      DateTime? @db.Time
  endTime        DateTime? @db.Time
  location       String?   @db.NVarChar(200)
  objective      String?   @db.NVarChar(Max)
  activitiesDone String?   @db.NVarChar(Max)
  commitments    String?   @db.NVarChar(Max)
  observations   String?   @db.NVarChar(Max)
  status         String    @default("programada") @db.NVarChar(30)
  createdById    String    @db.UniqueIdentifier
  createdAt      DateTime  @default(now()) @db.DateTime2
  updatedAt      DateTime  @updatedAt @db.DateTime2

  project        Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy      User      @relation("VisitCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitActivities VisitActivity[]

  @@map("Visitas")
}

model VisitActivity {
  visitId    String @db.UniqueIdentifier
  activityId String @db.UniqueIdentifier

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([visitId, activityId])
  @@map("ActividadesVisita")
}

// =============================================================================
// SECCIÓN 8: CAPACITACIONES
// =============================================================================

model Training {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  projectId     String    @db.UniqueIdentifier
  moduleId      String?   @db.UniqueIdentifier
  topic         String    @db.NVarChar(300)
  trainingDate  DateTime  @db.Date
  durationHours Decimal   @default(0) @db.Decimal(4, 2)
  location      String?   @db.NVarChar(200)
  objective     String?   @db.NVarChar(Max)
  observations  String?   @db.NVarChar(Max)
  trainerId     String?   @db.UniqueIdentifier
  status        String    @default("programada") @db.NVarChar(30)
  createdAt     DateTime  @default(now()) @db.DateTime2

  project       Project        @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  module        ProjectModule? @relation("TrainingModule", fields: [moduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainer       User?          @relation("TrainingTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participants  TrainingParticipant[]

  @@map("Capacitaciones")
}

model TrainingParticipant {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  trainingId String    @db.UniqueIdentifier
  staffId    String?   @db.UniqueIdentifier
  userId     String?   @db.UniqueIdentifier
  attendedAt DateTime? @db.DateTime2

  training   Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  staff      ClientStaff? @relation("ParticipantStaff", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User?        @relation("ParticipantUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ParticipantesCapacitacion")
}

// =============================================================================
// SECCIÓN 9: DOCUMENTOS Y FIRMAS
// =============================================================================

model Document {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  projectId     String    @db.UniqueIdentifier
  documentType  String    @db.NVarChar(50)
  title         String    @db.NVarChar(300)
  filePath      String?   @db.NVarChar(500)
  fileFormat    String?   @db.NVarChar(10)
  status        String    @default("borrador") @db.NVarChar(30)
  relatedId     String?   @db.UniqueIdentifier
  generatedById String    @db.UniqueIdentifier
  generatedAt   DateTime  @default(now()) @db.DateTime2
  finalizedAt   DateTime? @db.DateTime2

  project     Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generatedBy User     @relation("DocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  signatures  Signature[]

  @@map("Documentos")
}

model Signature {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  documentId    String   @db.UniqueIdentifier
  signerType    String   @db.NVarChar(20)   // 'agent' | 'client_staff'
  userId        String?  @db.UniqueIdentifier
  staffId       String?  @db.UniqueIdentifier
  signatureType String   @default("drawn") @db.NVarChar(20)
  signatureFile String?  @db.NVarChar(500)
  signedAt      DateTime @default(now()) @db.DateTime2
  ipAddress     String?  @db.NVarChar(50)
  deviceInfo    String?  @db.NVarChar(300)

  document  Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User?       @relation("SignatureUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff     ClientStaff? @relation("SignatureStaff", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Firmas")
}

// =============================================================================
// SECCIÓN 10: EVIDENCIAS
// =============================================================================

model Evidence {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  entityType   String   @db.NVarChar(50)    // 'activity' | 'visit' | 'training' | 'project'
  entityId     String   @db.NVarChar(36)    // UUID como string (sin FK polimórfica)
  fileName     String   @db.NVarChar(300)
  filePath     String   @db.NVarChar(500)
  fileType     String?  @db.NVarChar(20)
  fileSizeKb   Int?
  description  String?  @db.NVarChar(500)
  uploadedById String   @db.UniqueIdentifier
  uploadedAt   DateTime @default(now()) @db.DateTime2

  uploadedBy   User     @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Evidencias")
}

// =============================================================================
// SECCIÓN 11: RIESGOS
// =============================================================================

model Risk {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  projectId   String   @db.UniqueIdentifier
  entityType  String   @db.NVarChar(50)    // 'project' | 'activity' | 'visit'
  entityId    String   @db.NVarChar(36)    // UUID como string (sin FK polimórfica)
  name        String   @db.NVarChar(300)
  description String?  @db.NVarChar(Max)
  category    String?  @db.NVarChar(100)
  level       String   @default("media") @db.NVarChar(20)
  probability String   @default("media") @db.NVarChar(20)
  impact      String   @default("medio") @db.NVarChar(20)
  mitigation  String?  @db.NVarChar(Max)
  status      String   @default("activo") @db.NVarChar(30)
  createdAt   DateTime @default(now()) @db.DateTime2
  updatedAt   DateTime @updatedAt @db.DateTime2

  project     Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Riesgos")
}

// =============================================================================
// SECCIÓN 12: NOVEDADES
// =============================================================================

model Novelty {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  projectId       String   @db.UniqueIdentifier
  noveltyType     String   @db.NVarChar(50)
  title           String   @db.NVarChar(300)
  description     String?  @db.NVarChar(Max)
  impact          String?  @db.NVarChar(Max)
  affectsSchedule Boolean  @default(false)
  daysImpact      Int      @default(0)
  status          String   @default("abierta") @db.NVarChar(30)
  reportedById    String   @db.UniqueIdentifier
  createdAt       DateTime @default(now()) @db.DateTime2
  updatedAt       DateTime @updatedAt @db.DateTime2

  project      Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedBy   User    @relation("NoveltyReportedBy", fields: [reportedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("Novedades")
}

// =============================================================================
// SECCIÓN 13: LECCIONES APRENDIDAS
// =============================================================================

model LessonsLearned {
  id                         String   @id @default(uuid()) @db.UniqueIdentifier
  projectId                  String   @db.UniqueIdentifier
  whatWentWell               String?  @db.NVarChar(Max)
  whatWentWrong              String?  @db.NVarChar(Max)
  implementerRecommendations String?  @db.NVarChar(Max)
  clientRecommendations      String?  @db.NVarChar(Max)
  aiAnalysis                 String?  @db.NVarChar(Max)
  createdById                String   @db.UniqueIdentifier
  createdAt                  DateTime @default(now()) @db.DateTime2
  updatedAt                  DateTime @updatedAt @db.DateTime2

  project    Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User    @relation("LessonsCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("LeccionesAprendidas")
}

// =============================================================================
// SECCIÓN 14: ENTREGA A SOPORTE
// =============================================================================

model SupportHandover {
  id                      String   @id @default(uuid()) @db.UniqueIdentifier
  projectId               String   @unique @db.UniqueIdentifier
  modulesImplemented      String?  @db.NVarChar(Max)
  infraValidated          Boolean  @default(false)
  trainingCompleted       Boolean  @default(false)
  documentationDelivered  Boolean  @default(false)
  electronicEmission      Boolean  @default(false)
  observations            String?  @db.NVarChar(Max)
  handoverDate            DateTime? @db.Date
  status                  String   @default("pendiente") @db.NVarChar(30)
  createdById             String   @db.UniqueIdentifier
  createdAt               DateTime @default(now()) @db.DateTime2
  updatedAt               DateTime @updatedAt @db.DateTime2

  project    Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User    @relation("HandoverCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("EntregasSoporte")
}

// =============================================================================
// SECCIÓN 15: INFORMES Y CORREOS
// =============================================================================

model ScheduledReport {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  projectId   String    @db.UniqueIdentifier
  reportType  String    @db.NVarChar(50)
  frequency   String    @db.NVarChar(20)
  cronExpr    String?   @db.NVarChar(50)
  formats     String    @default("pdf") @db.NVarChar(100)
  recipients  String?   @db.NVarChar(Max)
  isActive    Boolean   @default(true)
  lastRunAt   DateTime? @db.DateTime2
  nextRunAt   DateTime? @db.DateTime2
  createdById String    @db.UniqueIdentifier
  createdAt   DateTime  @default(now()) @db.DateTime2

  project    Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User    @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("InformesProgramados")
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  companyId String   @db.UniqueIdentifier
  name      String   @db.NVarChar(200)
  slug      String   @db.NVarChar(100)
  subject   String   @db.NVarChar(300)
  bodyHtml  String   @db.NVarChar(Max)
  variables String?  @db.NVarChar(Max)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime2

  company   Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, slug])
  @@map("PlantillasCorreo")
}

// =============================================================================
// SECCIÓN 16: NOTIFICACIONES Y AUDITORÍA
// =============================================================================

model Notification {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  userId     String    @db.UniqueIdentifier
  type       String    @db.NVarChar(50)
  title      String    @db.NVarChar(300)
  message    String?   @db.NVarChar(Max)
  entityType String?   @db.NVarChar(50)
  entityId   String?   @db.UniqueIdentifier
  isRead     Boolean   @default(false)
  readAt     DateTime? @db.DateTime2
  createdAt  DateTime  @default(now()) @db.DateTime2

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Notificaciones")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  companyId  String?  @db.UniqueIdentifier
  userId     String?  @db.UniqueIdentifier
  entityType String   @db.NVarChar(100)
  entityId   String?  @db.NVarChar(100)
  action     String   @db.NVarChar(50)
  oldValues  String?  @db.NVarChar(Max)
  newValues  String?  @db.NVarChar(Max)
  ipAddress  String?  @db.NVarChar(50)
  userAgent  String?  @db.NVarChar(500)
  createdAt  DateTime @default(now()) @db.DateTime2

  company    Company? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("RegistroAuditoria")
}

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#060d1c"/>
      <stop offset="100%" style="stop-color:#1E3A5F"/>
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5dade2"/>
      <stop offset="50%" style="stop-color:#2D5086"/>
      <stop offset="100%" style="stop-color:#7c3aed"/>
    </linearGradient>
    <filter id="blur">
      <feGaussianBlur stdDeviation="8" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Fondo -->
  <rect width="512" height="512" rx="96" fill="url(#bg)"/>

  <!-- Glow exterior -->
  <rect width="512" height="512" rx="96" fill="none"
    stroke="rgba(93,173,226,0.3)" stroke-width="2"/>

  <!-- Letra A estilizada -->
  <g transform="translate(256,256)">
    <!-- Trazo izquierdo de la A -->
    <path d="M-90,90 L0,-100 L90,90" fill="none"
      stroke="url(#glow)" stroke-width="36"
      stroke-linecap="round" stroke-linejoin="round"/>
    <!-- Barra horizontal de la A -->
    <line x1="-52" y1="18" x2="52" y2="18"
      stroke="url(#glow)" stroke-width="28"
      stroke-linecap="round"/>
    <!-- Punto de acento arriba -->
    <circle cx="0" cy="-108" r="10" fill="#5dade2" opacity="0.9"/>
  </g>

  <!-- Brillo superior (efecto glass) -->
  <ellipse cx="256" cy="80" rx="180" ry="40"
    fill="rgba(255,255,255,0.07)"/>
</svg>
